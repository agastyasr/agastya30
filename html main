<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Agastya Singh Rathore</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Syne:wght@400;700&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
<style>
  /* ── THEME TOKENS ── */
  [data-theme="dark"] {
    --bg: #0d0d0d;
    --surface: #161616;
    --surface2: #1e1e1e;
    --border: rgba(255,255,255,0.07);
    --white: #efefef;
    --dim: rgba(239,239,239,0.38);
    --gold: #c9a84c;
    --shadow: rgba(0,0,0,0.5);
  }
  [data-theme="light"] {
    --bg: #f5f3ef;
    --surface: #eceae5;
    --surface2: #e2e0da;
    --border: rgba(0,0,0,0.08);
    --white: #111111;
    --dim: rgba(17,17,17,0.45);
    --gold: #a07828;
    --shadow: rgba(0,0,0,0.12);
  }

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--white);
    font-family: 'Syne', sans-serif;
    overflow-x: hidden;
    transition: background 0.3s, color 0.3s;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 200;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.3rem 3rem;
    background: rgba(13,13,13,0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    transition: background 0.3s;
  }
  [data-theme="light"] nav { background: rgba(245,243,239,0.88); }
  .nav-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; letter-spacing: 0.12em; color: var(--white); }
  .nav-right { display: flex; align-items: center; gap: 2rem; }
  .nav-links { display: flex; gap: 2rem; }
  .nav-links a {
    font-family: 'DM Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--dim); text-decoration: none; transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--white); }

  /* Theme toggle */
  .theme-btn {
    width: 36px; height: 20px; border-radius: 10px;
    background: var(--surface2); border: 1px solid var(--border);
    cursor: pointer; position: relative; transition: background 0.3s;
    flex-shrink: 0;
  }
  .theme-btn::after {
    content: '';
    position: absolute; top: 2px; left: 2px;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--gold);
    transition: transform 0.3s;
  }
  [data-theme="light"] .theme-btn::after { transform: translateX(16px); }

  /* ── HERO ── */
  .hero {
    min-height: 100vh; display: flex; flex-direction: column;
    justify-content: flex-end; padding: 0 3rem 5rem;
    border-bottom: 1px solid var(--border);
  }
  .hero-eyebrow {
    font-family: 'DM Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 1.5rem;
    opacity: 0; animation: up 0.6s ease 0.1s forwards;
  }
  .hero-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(4.5rem, 10vw, 10rem); line-height: 0.88;
    opacity: 0; animation: up 0.6s ease 0.25s forwards;
  }
  .hero-row {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-top: 3rem; opacity: 0; animation: up 0.6s ease 0.4s forwards;
  }
  .hero-bio { max-width: 360px; font-size: 0.88rem; line-height: 1.75; color: var(--dim); }
  .hero-stats { display: flex; gap: 3rem; }
  .stat-num { font-family: 'Bebas Neue', sans-serif; font-size: 2.2rem; color: var(--white); line-height: 1; display: block; }
  .stat-label { font-family: 'DM Mono', monospace; font-size: 0.58rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--dim); display: block; margin-top: 0.2rem; }

  /* ── TICKER ── */
  .ticker { overflow: hidden; border-bottom: 1px solid var(--border); padding: 0.85rem 0; background: var(--surface); }
  .ticker-track { display: inline-flex; gap: 2.5rem; white-space: nowrap; animation: ticker 24s linear infinite; }
  .ticker-item { font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dim); }
  .ticker-item.hl { color: var(--gold); }
  @keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ── SECTIONS ── */
  section { padding: 6rem 3rem; border-bottom: 1px solid var(--border); }
  .label { font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--dim); margin-bottom: 1rem; }
  .section-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.5rem, 4vw, 4rem); line-height: 1; margin-bottom: 3rem; }

  /* ── WHAT I CREATE ── */
  .create-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--border); border: 1px solid var(--border);
  }
  .create-card {
    background: var(--bg); padding: 2rem 1.8rem;
    transition: background 0.25s; position: relative; overflow: hidden;
  }
  .create-card:hover { background: var(--surface); }
  .create-emoji { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .create-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 0.04em; margin-bottom: 0.5rem; }
  .create-desc { font-size: 0.82rem; line-height: 1.7; color: var(--dim); }

  /* ── YOUTUBE EMBED ── */
  .yt-section { background: var(--bg); }
  .yt-wrap {
    position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;
    border: 1px solid var(--border); margin-top: 0;
  }
  .yt-wrap iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
  .yt-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 1.2rem; }
  .yt-channel { font-family: 'DM Mono', monospace; font-size: 0.65rem; letter-spacing: 0.12em; color: var(--dim); }
  .yt-link {
    font-family: 'DM Mono', monospace; font-size: 0.65rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gold); text-decoration: none;
    border-bottom: 1px solid var(--gold); padding-bottom: 0.1rem; transition: opacity 0.2s;
  }
  .yt-link:hover { opacity: 0.7; }

  /* ── COLLABS ── */
  .collab-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); border: 1px solid var(--border); }
  .collab-card { background: var(--bg); padding: 2.5rem; display: flex; gap: 2rem; align-items: flex-start; transition: background 0.25s; }
  .collab-card:hover { background: var(--surface); }
  .logo-wrap { flex-shrink: 0; width: 76px; height: 76px; }
  .logo-wrap svg { width: 76px; height: 76px; }
  .collab-brand { font-family: 'Bebas Neue', sans-serif; font-size: 1.9rem; letter-spacing: 0.04em; line-height: 1; margin-bottom: 0.3rem; }
  .collab-origin { font-family: 'DM Mono', monospace; font-size: 0.58rem; letter-spacing: 0.15em; color: var(--gold); margin-bottom: 1rem; }
  .collab-desc { font-size: 0.83rem; line-height: 1.75; color: var(--dim); }
  .collab-tags { display: flex; gap: 0.5rem; margin-top: 1.2rem; flex-wrap: wrap; }
  .tag { font-family: 'DM Mono', monospace; font-size: 0.57rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); border: 1px solid var(--border); padding: 0.2rem 0.55rem; }

  /* ── ABOUT ── */
  .about-grid { display: grid; grid-template-columns: auto 1fr; gap: 5rem; align-items: start; }
  .about-num { font-family: 'Bebas Neue', sans-serif; font-size: clamp(6rem, 12vw, 12rem); line-height: 1; color: transparent; -webkit-text-stroke: 1px rgba(128,128,128,0.2); }
  .about-text { font-size: 0.9rem; line-height: 1.8; color: var(--dim); margin-bottom: 1rem; }
  .about-text strong { color: var(--white); font-weight: 700; }
  .facts { list-style: none; display: flex; flex-direction: column; gap: 0.65rem; margin-top: 1.5rem; }
  .facts li { font-family: 'DM Mono', monospace; font-size: 0.7rem; letter-spacing: 0.07em; color: var(--dim); padding-left: 1.2rem; position: relative; }
  .facts li::before { content: '—'; position: absolute; left: 0; color: var(--gold); }

  /* ── GEAR ── */
  .gear-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); }
  .gear-row { background: var(--bg); padding: 1.4rem 1.8rem; display: flex; justify-content: space-between; align-items: center; transition: background 0.25s; }
  .gear-row:hover { background: var(--surface); }
  .gear-category { font-family: 'DM Mono', monospace; font-size: 0.58rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--dim); margin-bottom: 0.3rem; }
  .gear-name { font-family: 'Syne', sans-serif; font-size: 0.92rem; font-weight: 700; color: var(--white); }
  .gear-icon { font-size: 1.5rem; opacity: 0.6; }

  /* ── PLATFORMS ── */
  .platform-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); border: 1px solid var(--border); }
  .platform-card { background: var(--bg); padding: 2.5rem; transition: background 0.25s; }
  .platform-card:hover { background: var(--surface); }
  .platform-name { font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dim); margin-bottom: 1rem; }
  .platform-num { font-family: 'Bebas Neue', sans-serif; font-size: 4rem; line-height: 1; color: var(--white); }
  .platform-sub { font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--dim); margin-top: 0.4rem; }

  /* ── COLLAB FORM ── */
  .form-section { background: var(--surface); }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group.full { grid-column: 1 / -1; }
  .form-label { font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--dim); }
  .form-input, .form-select, .form-textarea {
    background: var(--bg); border: 1px solid var(--border);
    color: var(--white); font-family: 'Syne', sans-serif; font-size: 0.85rem;
    padding: 0.75rem 1rem; outline: none; transition: border-color 0.2s;
    appearance: none; -webkit-appearance: none;
  }
  .form-input:focus, .form-select:focus, .form-textarea:focus { border-color: var(--gold); }
  .form-textarea { resize: vertical; min-height: 110px; }
  .form-select { cursor: pointer; }
  .form-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; grid-column: 1/-1; }
  .form-note { font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--dim); }
  .form-success {
    display: none; grid-column: 1/-1; text-align: center;
    padding: 1.5rem; border: 1px solid var(--gold);
    font-family: 'DM Mono', monospace; font-size: 0.75rem;
    letter-spacing: 0.12em; color: var(--gold);
  }

  /* ── CONTACT ── */
  .contact-inner { display: flex; justify-content: space-between; align-items: flex-end; }
  .contact-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 6vw, 6rem); line-height: 0.9; }
  .contact-title span { color: var(--gold); }
  .contact-right { display: flex; flex-direction: column; gap: 1rem; align-items: flex-end; text-align: right; }
  .contact-note { font-family: 'DM Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; color: var(--dim); }
  .btn { display: inline-block; font-family: 'DM Mono', monospace; font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; color: var(--bg); background: var(--white); padding: 0.85rem 1.8rem; transition: background 0.2s, color 0.2s; border: none; cursor: pointer; }
  .btn:hover { background: var(--gold); color: var(--bg); }
  .btn-outline { background: transparent; color: var(--white); border: 1px solid var(--border); }
  .btn-outline:hover { border-color: var(--gold); color: var(--gold); background: transparent; }
  .contact-links { display: flex; gap: 1.5rem; }
  .contact-link { font-family: 'DM Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; color: var(--dim); text-decoration: none; transition: color 0.2s; }
  .contact-link:hover { color: var(--white); }

  /* ── FOOTER ── */
  footer { padding: 1.5rem 3rem; display: flex; justify-content: space-between; align-items: center; }
  footer span { font-family: 'DM Mono', monospace; font-size: 0.58rem; letter-spacing: 0.1em; color: var(--dim); }

  /* ── REVEAL ── */
  .reveal { opacity: 0; transform: translateY(16px); transition: opacity 0.55s ease, transform 0.55s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  @keyframes up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    nav { padding: 1.1rem 1.5rem; }
    .nav-links { display: none; }
    .hero { padding: 0 1.5rem 4rem; }
    section { padding: 4rem 1.5rem; }
    .collab-grid, .platform-grid, .about-grid, .create-grid, .gear-grid { grid-template-columns: 1fr; }
    .form-grid { grid-template-columns: 1fr; }
    .hero-row { flex-direction: column; gap: 2rem; align-items: flex-start; }
    .contact-inner { flex-direction: column; gap: 2.5rem; align-items: flex-start; }
    .contact-right { align-items: flex-start; text-align: left; }
    footer { flex-direction: column; gap: 0.4rem; padding: 1.5rem; }
  }
</style>
</head>
